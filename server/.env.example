# Any OpenAI-compatible endpoint. Examples:
#   OpenAI:      https://api.openai.com/v1
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama:      http://localhost:11434/v1
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-me
AI_MODEL=gpt-4o-mini


# Comma-separated origins allowed to call the API.
# Use the origin form: chrome-extension://<id>. Copy the id from the extension's card on chrome://extensions.
ALLOWED_ORIGINS=chrome-extension://your-extension-id

RATE_LIMIT_PER_HOUR=40
MAX_OUTPUT_TOKENS=1200

# Some newer OpenAI models want "max_completion_tokens" instead of "max_tokens".
MAX_TOKENS_PARAM=max_tokens

# --- Rate limiting: Upstash Redis (console.upstash.com → Redis → REST API) ---
# Leave empty to fall back to in-memory limits (local dev only; not shared on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analytics: Neon Postgres (console.neon.tech → Connection string, pooled) ---
# Leave empty to turn analytics off.
DATABASE_URL=
# Random string mixed into the hashed install id. Set once and don't change it.
ANALYTICS_SALT=

# --- /analytics admin page ---
ANALYTICS_PASSWORD=
# Random secret that signs the admin cookie, e.g. `openssl rand -base64 32`.
ANALYTICS_SECRET=
