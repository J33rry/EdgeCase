{
  "manifest_version": 3,
  "name": "EdgeCase — LeetCode Companion",
  "short_name": "EdgeCase",
  "version": "0.1.0",
  "description": "Your LeetCode profile, your friends' stats, and an AI tutor that helps you understand problems without solving them for you.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "permissions": ["storage", "cookies", "scripting", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://leetcode.com/*"],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["src/content/index.jsx"],
      "run_at": "document_idle"
    }
  ]
}
